#!/usr/bin/env sh

# Try to load scripting addition (requires sudoers NOPASSWD config for yabai)
# Register Dock restart hook even if the initial load fails (Dock might not be ready yet).
yabai -m signal --add label=load-sa event=dock_did_restart action="sudo -n /opt/homebrew/bin/yabai --load-sa" 2>/dev/null
if sudo -n /opt/homebrew/bin/yabai --load-sa >/dev/null 2>&1; then
  true
else
  echo "yabai: scripting addition failed to load (check sudoers)" >&2
fi

yabai -m config window_animation_duration 0.0
yabai -m config window_animation_easing   ease_out_quint
yabai -m config auto_balance              off
# window_topmost was removed in yabai 7.x; use window_shadow instead to keep floats unobtrusive
yabai -m config window_shadow             off

# --- Padding and Gaps (razor thin for maximum screen use) ---
yabai -m config top_padding               2
yabai -m config bottom_padding            2
yabai -m config left_padding              2
yabai -m config right_padding             2
yabai -m config window_gap                2

# --- Mouse Support ---
yabai -m config mouse_modifier            fn
yabai -m config mouse_action1             move
yabai -m config mouse_action2             resize
yabai -m config mouse_drop_action         swap

# --- Split Behavior ---
yabai -m config split_type                auto
yabai -m config split_ratio               0.50

# Reserve space for sketchybar (28px height matches bar_height in state.json)
yabai -m config external_bar all:28:0

# --- Shared window layer ---
# Without a rule yabai puts tiled windows on sub-layer below and every other
# window on normal, so on a float (manual) space any app without a rule sat
# permanently above apps ruled below (Claude, Yaze). One shared layer lets
# focus decide. Keep this first: later rules (and Barista's app levels,
# restored at the end) override it.
yabai -m rule --add label="barista-level-base" app=".*" sub-layer=below

# --- Tiling Rules ---
# Manage (Tile) these apps explicitly if needed, but default is to tile everything unless excluded.
# yabai -m rule --add app="^Code$" manage=on
# yabai -m rule --add app="^Terminal$" manage=on

# Claude stays movable/tilable without floating above tiled windows.
yabai -m rule --add label="claude-window-layer" app="^Claude$" role="^AXWindow$" subrole="^AXStandardWindow$" sub-layer=below sticky=off

# --- Floating Rules (manage=off) ---
# System / Utilities
yabai -m rule --add app="^(System Settings|System Information|Activity Monitor|Calculator|Dictionary|Software Update|Archive Utility)$" manage=off
yabai -m rule --add app="^(Photo Booth|QuickTime Player|VLC)$" manage=off sub-layer=below
yabai -m rule --add app="^Finder$" manage=off sub-layer=below
yabai -m rule --add label="About This Mac" app="System Information" title="About This Mac" manage=off

# Apps that behave better floating
# Match tiled/editor windows so Emacs participates in focus-based stacking.
yabai -m rule --add label="emacs-window-layer" app="^Emacs$" manage=off sub-layer=below sticky=off
yabai -m rule --add app="^(Mesen|Mesen2.*)$" manage=off sub-layer=below
# Yaze uses ImGui utility windows, so keep it unmanaged while matching the
# tiled-window sub-layer. This prevents the main editor from staying above
# unrelated windows.
yabai -m rule --add app="^Yaze$" manage=off sub-layer=below
yabai -m rule --add app="^oracle_manager_gui$" manage=off
yabai -m rule --add app="^Alfred$" manage=off
yabai -m rule --add app="^Raycast$" manage=off
yabai -m rule --add app="^Taskwarrior$" manage=off
yabai -m rule --add app="^Lazygit$" manage=off grid=10:10:1:1:8:8 title="lazygit"

# Barista + Halext tools
# Barista settings should stay unmanaged by default; it is a utility surface, not a tiled workspace app.
yabai -m rule --add app="^barista_config$" manage=off sub-layer=below
yabai -m rule --add app="^Barista Config$" manage=off sub-layer=below
yabai -m rule --add app="^Barista$" manage=off sub-layer=below
yabai -m rule --add app="^Barista Control Panel$" manage=off sub-layer=below
yabai -m rule --add app="^BaristaControlPanel$" manage=off sub-layer=below
yabai -m rule --add app="^afs_studio$" manage=off
yabai -m rule --add app="^AFS Studio$" manage=off
yabai -m rule --add app="^afs-browser$" manage=off
yabai -m rule --add app="^AFS Browser$" manage=off
yabai -m rule --add app="^cortex$" manage=off
yabai -m rule --add app="^Cortex$" manage=off
yabai -m rule --add app="^sys_manual$" manage=off
yabai -m rule --add app="^System Manual$" manage=off
# PictureView reports its app name without a space in yabai.
yabai -m rule --add app="^(Picture View|PictureView)$" manage=off

# Browser Popups
yabai -m rule --add app="^Safari$" title="^(General|Tabs|Passwords|Preferences)$" manage=off
yabai -m rule --add app="^Chrome$" title="^(Settings|Preferences)$" manage=off

# Unmanaged Helper
UNMANAGED_APPS_CONF="$HOME/.config/sketchybar/unmanaged_apps.conf"
UNMANAGED_APPS_SCRIPT="$HOME/.config/scripts/update_unmanaged_apps.sh"

# The helper's rules must land before saved app defaults are restored, so it
# runs in the foreground, but a hung helper must not stall yabai's startup.
# Deadline in tenths of a second.
run_unmanaged_helper() {
  "$UNMANAGED_APPS_SCRIPT" --from-yabairc &
  helper_pid=$!
  helper_waited=0
  while kill -0 "$helper_pid" 2>/dev/null; do
    if [ "$helper_waited" -ge "${BARISTA_UNMANAGED_HELPER_DEADLINE:-50}" ]; then
      kill "$helper_pid" 2>/dev/null
      wait "$helper_pid" 2>/dev/null
      echo "yabai: unmanaged app helper timed out; continuing without it" >&2
      return 1
    fi
    sleep 0.1
    helper_waited=$((helper_waited + 1))
  done
  wait "$helper_pid" || echo "yabai: unmanaged app helper failed" >&2
}

# Apply additional unmanaged app rules from the config app if provided
if [ -x "$UNMANAGED_APPS_SCRIPT" ]; then
  run_unmanaged_helper || true
elif [ -r "$UNMANAGED_APPS_CONF" ]; then
  while IFS= read -r unmanaged_app || [ -n "$unmanaged_app" ]; do
    unmanaged_app="${unmanaged_app#"${unmanaged_app%%[![:space:]]*}"}"
    unmanaged_app="${unmanaged_app%"${unmanaged_app##*[![:space:]]}"}"
    [ -z "$unmanaged_app" ] && continue
    case "$unmanaged_app" in \#*) continue ;; esac
    label="$(printf '%s' "$unmanaged_app" | tr -c '[:alnum:]' '_')"
    [ -n "$label" ] || label="app"
    # "Foo Bar" and "Foo-Bar" flatten alike; the checksum keeps their rules apart.
    label="${label}-$(printf '%s' "$unmanaged_app" | cksum | cut -d' ' -f1)"
    escaped="$(printf '%s' "$unmanaged_app" | sed 's/[][\\.^$*+?(){}|]/\\&/g')"
    # Leave layering to existing app rules, including Yaze and Mesen below.
    yabai -m rule --add label="unmanaged-${label}" app="^${escaped}$" manage=off
  done < "$UNMANAGED_APPS_CONF"
fi

# Restore only saved choices, after the base rules so explicit app defaults win.
# New space choices follow their UUID across Mission Control reorders.
BARISTA_RUNTIME="${BARISTA_CONFIG_DIR:-$HOME/.config/sketchybar}"
RESTORE_SCRIPT="$BARISTA_RUNTIME/scripts/yabai_restore.py"

# A restart forgets every signal, and SketchyBar registers Barista's (spaces,
# displays, the Mission Control guard) only when it loads. Replay them when the
# bar is already running; a bar that starts later registers its own.
SIGNAL_REPLAY="$HOME/.local/state/barista/yabai_signals.sh"
replay_barista_signals() {
  if [ -f "$SIGNAL_REPLAY" ] && pgrep -x sketchybar >/dev/null 2>&1; then
    /bin/sh "$SIGNAL_REPLAY" || echo "yabai: Barista's space signals could not be restored" >&2
  fi
}

if [ -f "$RESTORE_SCRIPT" ]; then
  if ! python3 "$RESTORE_SCRIPT" --startup; then
    echo "yabai: base configuration loaded; saved preferences could not be fully restored" >&2
    replay_barista_signals
    return 1 2>/dev/null || exit 1
  fi
fi

# Saved spaces now have explicit per-space layouts; the default applies only
# to spaces without a saved choice. Applying this earlier can retile Manual.
if ! yabai -m config layout bsp; then
  echo "yabai: default layout could not be configured" >&2
  return 1 2>/dev/null || exit 1
fi

# Rules reach only new windows. Once every space has its layout, move open
# windows to their rules' layer (tiling put them on below). Best effort.
if [ -f "$RESTORE_SCRIPT" ]; then
  python3 "$RESTORE_SCRIPT" --restack || echo "yabai: open windows keep their old stacking" >&2
fi

replay_barista_signals

echo "yabai: configuration loaded successfully"
